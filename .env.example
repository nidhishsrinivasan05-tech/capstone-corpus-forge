# Corpus Forge Environment Configuration

# Flask Application Secret Key
CORPUS_FORGE_SECRET=your-secret-key-here

# Upload folder path for document ingestion
CORPUS_FORGE_UPLOADS=data/uploads

# GitHub API Configuration (optional)
GITHUB_TOKEN=your-github-token-here
GITHUB_API_ENDPOINT=https://api.github.com

# Database Configuration (if applicable)
DATABASE_URL=sqlite:///corpus_forge.db

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=True

# Server Configuration
PORT=5000
HOST=127.0.0.1
