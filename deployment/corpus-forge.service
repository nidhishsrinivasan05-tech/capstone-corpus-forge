[Unit]
Description=Corpus Forge Web Application
After=network.target

[Service]
Type=notify
User=corpus-forge
WorkingDirectory=/opt/corpus-forge
Environment="PATH=/opt/corpus-forge/venv/bin"
EnvironmentFile=/opt/corpus-forge/.env
ExecStart=/opt/corpus-forge/venv/bin/gunicorn \
    --workers=4 \
    --worker-class=sync \
    --bind=0.0.0.0:5000 \
    --timeout=60 \
    --access-logfile=/var/log/corpus-forge/access.log \
    --error-logfile=/var/log/corpus-forge/error.log \
    "app:create_app()"
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/corpus-forge/data

[Install]
WantedBy=multi-user.target
